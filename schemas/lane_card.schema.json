{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glitchworks.dev/schemas/lane_card.schema.json",
  "title": "LaneCard",
  "type": "object",
  "required": ["id", "title", "order", "matchers"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "emoji": { "type": "string" },
    "accent": { "type": "string" },
    "order": { "type": "integer" },
    "matchPriority": { "type": "integer" },
    "match": { "enum": ["all", "any"] },
    "require": {
      "type": "object",
      "properties": {
        "authorType": { "enum": ["human", "bot", "external"] },
        "isDraft": { "type": "boolean" }
      }
    },
    "matchers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["authorType", "isDraft", "flood", "titlePrefix", "refContains", "label"]
          },
          "value": { "type": ["string", "boolean"] }
        }
      }
    }
  }
}
