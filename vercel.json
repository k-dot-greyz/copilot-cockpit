  ],
  "headers": [
    {
      "source": "/ecosystem/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/cards/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/cards/dex/:id",
      "destination": "https://raw.githubusercontent.com/k-dot-greyz/copilot-cockpit/main/dex/cards/:id.json"
    },
    {
      "source": "/cards/index",
      "destination": "https://raw.githubusercontent.com/k-dot-greyz/copilot-cockpit/main/dex/cards/index.json"
    },
    {
      "source": "/.well-known/dex-card",
      "destination": "https://raw.githubusercontent.com/k-dot-greyz/copilot-cockpit/main/dex-entry.md"
    }
  ]
}
