{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cardcore://schemas/kinds/core.pack.v1.json",
  "title": "core.pack",
  "description": "A manifest of cards with relative paths and file digests. See SPEC.md sections 4.1 and 8.2.",
  "allOf": [
    { "$ref": "cardcore://schemas/card.v1.json" },
    {
      "properties": {
        "kind": { "const": "core.pack" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaults_ref", "requires", "cards"],
          "properties": {
            "defaults_ref": {
              "anyOf": [
                { "$ref": "cardcore://schemas/core.v1.json#/$defs/id" },
                { "type": "null" }
              ]
            },
            "requires": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pack", "rev"],
                "properties": {
                  "pack": { "$ref": "cardcore://schemas/core.v1.json#/$defs/id" },
                  "rev": { "$ref": "cardcore://schemas/core.v1.json#/$defs/rev" }
                }
              }
            },
            "cards": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "schema_version", "rev", "path", "sha256"],
                "properties": {
                  "id": { "$ref": "cardcore://schemas/core.v1.json#/$defs/id" },
                  "kind": { "$ref": "cardcore://schemas/core.v1.json#/$defs/kind" },
                  "schema_version": { "type": "integer", "minimum": 1 },
                  "rev": { "$ref": "cardcore://schemas/core.v1.json#/$defs/rev" },
                  "path": { "$ref": "cardcore://schemas/core.v1.json#/$defs/path" },
                  "sha256": { "$ref": "cardcore://schemas/core.v1.json#/$defs/sha256" }
                }
              }
            }
          }
        }
      }
    }
  ]
}
