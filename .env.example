# Copilot Cockpit — local overrides (copy to .env, never commit)
# MOD-ENV-SECURE stub — no real secrets

# Optional: override default triage target (dashboard also hardcodes; migrate to config)
COCKPIT_OWNER=k-dot-greyz
COCKPIT_REPO=dev-master

# Optional: smoke test token for agent quickstart (never log or commit)
# GITHUB_TOKEN=ghp_xxxxxxxx

# Astro dev server (default 4321; Playwright stub uses 5173 — align in MOD-PLAYWRIGHT-CONFIG)
# PORT=4321

# OAuth (PR #8 — serverless only, never client bundle)
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
